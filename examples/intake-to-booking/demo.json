{
  "v": 1,
  "title": "A quote request becomes a booked inspection",
  "panels": [
    {
      "id": "form",
      "type": "form",
      "label": "Your website's quote form",
      "config": {
        "site": "ridgelineroofing.com/quote",
        "title": "Request a quote",
        "intro": "Ridgeline Roofing. Every request gets an answer the same day.",
        "fields": [
          { "id": "name", "label": "Your name", "placeholder": "First and last name" },
          { "id": "address", "label": "Address", "placeholder": "Street and number" },
          { "id": "need", "label": "What do you need?", "options": ["Repair", "New roof", "Inspection"] },
          { "id": "details", "label": "Tell us more", "placeholder": "What is going on?" }
        ],
        "button": "Send request",
        "done": { "title": "Request received", "text": "Check your inbox. Your inspection time is on its way." }
      }
    },
    {
      "id": "flow",
      "type": "workflow",
      "label": "The automation",
      "config": {
        "nodes": [
          { "id": "got", "label": "New quote request", "icon": "form" },
          { "id": "read", "label": "Reads the request", "app": "AI", "icon": "sparkle", "after": ["got"] },
          { "id": "slot", "label": "Finds a free slot", "app": "Calendar", "icon": "calendar", "after": ["read"] },
          { "id": "book", "label": "Books the inspection", "icon": "check", "after": ["slot"] },
          { "id": "confirm", "label": "Emails the customer", "icon": "mail", "after": ["book"] },
          { "id": "brief", "label": "Briefs your crew", "icon": "bell", "after": ["book"] }
        ]
      }
    },
    {
      "id": "week",
      "type": "calendar",
      "label": "Your crew's week",
      "config": {
        "title": "This week",
        "ampm": true,
        "days": [
          { "id": "mon", "label": "Mon" },
          { "id": "tue", "label": "Tue" },
          { "id": "wed", "label": "Wed" },
          { "id": "thu", "label": "Thu" }
        ],
        "events": [
          { "id": "gutter", "day": "mon", "time": "10:30", "title": "Gutter repair, Elm St" },
          { "id": "pine", "day": "mon", "time": "13:00", "title": "Quote visit, Pine Ave" },
          { "id": "reroof-1", "day": "tue", "time": "13:00", "title": "Roof replacement" },
          { "id": "reroof-2", "day": "wed", "time": "08:00", "title": "Roof replacement" },
          { "id": "oak", "day": "thu", "time": "10:00", "title": "Quote visit, Oak Ct" }
        ]
      }
    },
    {
      "id": "mail",
      "type": "inbox",
      "label": "What the customer gets",
      "config": {
        "title": "Ruth's inbox",
        "mails": [
          { "id": "bank", "from": "Front Range Bank", "subject": "Your statement is ready", "time": "Sat" },
          { "id": "school", "from": "Lincoln Elementary", "subject": "Field trip on Friday", "time": "Fri" },
          { "id": "pharmacy", "from": "Corner Pharmacy", "subject": "Your order is ready", "time": "Thu" }
        ]
      }
    }
  ],
  "beats": [
    {
      "say": "Sunday evening. A homeowner finds a leak and opens your website.",
      "clock": "8:40 PM",
      "do": [
        { "on": "form", "type": "fill", "field": "name", "value": "Ruth Adeyemi" },
        { "on": "form", "type": "fill", "field": "address", "value": "14 Birch Lane", "after": 700 },
        { "on": "form", "type": "fill", "field": "need", "value": "Repair", "after": 700 },
        { "on": "form", "type": "fill", "field": "details", "value": "Water coming in after the storm", "after": 700 }
      ]
    },
    {
      "say": "Nobody is in the office. Send the request like they would.",
      "wait": "click",
      "do": [
        { "on": "form", "type": "submit" },
        { "on": "flow", "type": "run", "node": "got" }
      ]
    },
    {
      "say": "It is read on the spot: an active leak, so this one is urgent.",
      "do": [{ "on": "flow", "type": "run", "node": "read", "note": "Active leak, urgent" }]
    },
    {
      "say": "Your crew's week is checked for the first slot that is free.",
      "clock": "8:41 PM",
      "do": [{ "on": "flow", "type": "run", "node": "slot", "note": "Mon 8:00 AM is free" }]
    },
    {
      "say": "The inspection is booked. Your crew sees it in their week.",
      "do": [
        { "on": "flow", "type": "run", "node": "book" },
        { "on": "week", "type": "book", "id": "leak", "day": "mon", "time": "08:00", "title": "Leak, 14 Birch Lane", "tone": "info", "after": 400 }
      ]
    },
    {
      "say": "The homeowner gets a time, not a promise to call back.",
      "clock": "8:42 PM",
      "do": [
        { "on": "flow", "type": "run", "node": "confirm" },
        { "on": "mail", "type": "receive", "id": "booked", "from": "Ridgeline Roofing", "subject": "Inspection Monday 8 AM", "body": "Hi Ruth, sorry about the leak. Marco will be at 14 Birch Lane tomorrow, Monday, at 8:00 AM. Reply to change the time.", "time": "8:42 PM" },
        { "on": "mail", "type": "open", "mail": "booked", "after": 900 }
      ]
    },
    {
      "say": "By Monday morning your crew has the address. Nobody made a call.",
      "clock": "7:00 AM",
      "do": [{ "on": "flow", "type": "run", "node": "brief", "note": "Address and details sent" }]
    }
  ],
  "outcome": [
    { "value": "2 min", "label": "from request to booked visit", "was": "2 days" },
    { "value": "0", "label": "phone calls to find a time", "was": "3" },
    { "value": "+1", "label": "urgent job won on a Sunday" }
  ],
  "results": {
    "title": "What a slow callback costs",
    "text": "A homeowner with a leak takes the first roofer who names a time. This names one in two minutes, on a Sunday evening too.",
    "roi": {
      "currency": "USD",
      "inputs": [
        { "id": "requests", "label": "Quote requests a month", "stage": "Requests", "ask": "How many quote requests do you get in a month?", "value": 25 },
        { "id": "visit", "label": "Requests that book a visit", "stage": "Visits", "ask": "Of every 100 requests, how many end up booking a visit?", "value": 50, "kind": "percent" },
        { "id": "won", "label": "Visits that become a job", "stage": "Jobs", "value": 30, "kind": "percent", "note": "ServiceTitan's median close rate is 31 to 38%. We count 30." },
        { "id": "job", "label": "Worth of an average job", "ask": "What is an average job worth?", "value": 1800, "kind": "money" }
      ],
      "lever": { "input": "visit", "add": 20 },
      "cost": { "monthly": 350, "once": 2000 }
    }
  }
}

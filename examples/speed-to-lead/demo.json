{
  "v": 1,
  "title": "A new patient texts after closing time",
  "panels": [
    {
      "id": "phone",
      "type": "phone",
      "label": "Patient's phone",
      "config": { "contact": "Harbor Dental", "subtitle": "Text message" }
    },
    {
      "id": "flow",
      "type": "workflow",
      "label": "The automation",
      "config": {
        "nodes": [
          { "id": "text", "label": "New text message", "icon": "message" },
          { "id": "read", "label": "Reads what they need", "app": "AI", "icon": "sparkle", "after": ["text"] },
          { "id": "slots", "label": "Checks open slots", "app": "Calendar", "icon": "calendar", "after": ["read"] },
          { "id": "reply", "label": "Replies by text", "icon": "message", "after": ["slots"] },
          { "id": "save", "label": "Saves the lead", "app": "CRM", "icon": "users", "after": ["slots"] },
          { "id": "tell", "label": "Tells the front desk", "icon": "bell", "after": ["reply", "save"] }
        ]
      }
    },
    {
      "id": "crm",
      "type": "crm",
      "label": "Patient pipeline",
      "config": {
        "columns": [
          { "id": "new", "title": "New" },
          { "id": "talking", "title": "In conversation" },
          { "id": "booked", "title": "Booked" }
        ],
        "cards": [
          { "id": "omar", "column": "talking", "title": "Omar Haddad", "subtitle": "Whitening quote", "value": "$340" },
          { "id": "marta", "column": "talking", "title": "Marta Kowalski", "subtitle": "Braces consult", "value": "$90" },
          { "id": "priya", "column": "booked", "title": "Priya Nair", "subtitle": "Check-up", "value": "$120", "tag": "Mon 9:30 AM", "tone": "good" },
          { "id": "joel", "column": "booked", "title": "Joel Okafor", "subtitle": "Filling", "value": "$210", "tag": "Tue 2 PM", "tone": "good" }
        ]
      }
    },
    {
      "id": "numbers",
      "type": "kpi",
      "label": "This week",
      "config": {
        "tiles": [
          { "id": "reply", "label": "Time to first reply", "value": "14 h" },
          { "id": "closed", "label": "Booked while closed", "value": "$0" },
          { "id": "booked", "label": "New patients booked", "value": "2" }
        ],
        "chart": {
          "title": "Bookings made per day",
          "points": [
            { "label": "Mon", "value": 1 },
            { "label": "Tue", "value": 1 },
            { "label": "Wed", "value": 0 }
          ]
        }
      }
    }
  ],
  "beats": [
    {
      "say": "9:14 PM. The practice closed at six. Send the text a new patient would.",
      "clock": "9:14 PM",
      "wait": "click",
      "do": [{ "on": "phone", "type": "send", "text": "Hi, Dana Whitfield here. I chipped a tooth. Can I come in this week?" }]
    },
    {
      "say": "Nobody is at the desk. The text starts the automation anyway.",
      "do": [{ "on": "flow", "type": "run", "node": "text" }]
    },
    {
      "say": "It reads what the patient needs, the way your front desk would.",
      "do": [{ "on": "flow", "type": "run", "node": "read", "note": "Chipped tooth, wants this week" }]
    },
    {
      "say": "It looks in your calendar for times that are really open.",
      "do": [{ "on": "flow", "type": "run", "node": "slots", "note": "Thu 10 AM and Fri 2:30 PM free" }]
    },
    {
      "say": "They get a real answer with real times, 38 seconds later.",
      "do": [
        { "on": "flow", "type": "run", "node": "reply" },
        { "on": "phone", "type": "typing", "after": 300 },
        { "on": "phone", "type": "receive", "text": "Sorry to hear that, Dana! We can see you Thursday at 10 AM or Friday at 2:30 PM. Which works best?", "after": 1100 }
      ]
    },
    {
      "say": "The lead is in your pipeline before you have seen it.",
      "do": [
        { "on": "flow", "type": "run", "node": "save" },
        { "on": "crm", "type": "add", "id": "dana", "to": "new", "title": "Dana Whitfield", "subtitle": "Chipped tooth", "tag": "Replied in 38 sec", "tone": "info" }
      ]
    },
    {
      "say": "The patient picks a time. No phone tag tomorrow morning.",
      "clock": "9:16 PM",
      "do": [
        { "on": "phone", "type": "send", "text": "Thursday at 10 please" },
        { "on": "phone", "type": "receive", "text": "Done. You are booked for Thursday at 10 AM with Dr. Lin. See you then!", "after": 1100 },
        { "on": "crm", "type": "move", "card": "dana", "to": "booked" },
        { "on": "crm", "type": "set", "card": "dana", "value": "$180", "tag": "Thu 10 AM", "tone": "good", "after": 600 }
      ]
    },
    {
      "say": "You find out in the morning, with the chair already filled.",
      "clock": "7:30 AM",
      "do": [
        { "on": "flow", "type": "run", "node": "tell", "note": "Summary sent" },
        { "on": "numbers", "type": "set", "tile": "reply", "value": "38 sec", "delta": "was 14 h", "tone": "good" },
        { "on": "numbers", "type": "set", "tile": "closed", "value": "$180", "delta": "was $0", "tone": "good" },
        { "on": "numbers", "type": "set", "tile": "booked", "value": "3", "delta": "+1 overnight", "tone": "good" },
        { "on": "numbers", "type": "push", "label": "Wed", "value": 1 }
      ]
    }
  ],
  "outcome": [
    { "value": "38 sec", "label": "to first reply", "was": "14 h" },
    { "value": "$180", "label": "booked while you were closed", "was": "$0" },
    { "value": "+1", "label": "patient booked overnight" }
  ],
  "results": {
    "title": "What a missed evening text costs",
    "text": "A new patient who texts after closing books with whoever answers first. This answers in under a minute, every night, and puts the visit in the calendar.",
    "roi": {
      "currency": "USD",
      "inputs": [
        { "id": "texts", "label": "After-hours texts a month", "value": 40 },
        { "id": "won", "label": "Share you now book", "value": 30, "kind": "percent" },
        { "id": "visit", "label": "Worth of a first visit", "value": 180, "kind": "money" }
      ],
      "gains": [{ "label": "New patients booked", "from": ["texts", "won", "visit"] }],
      "cost": { "monthly": 300, "once": 1500 }
    }
  }
}

{
  "v": 1,
  "title": "A new patient texts after closing time",
  "panels": [
    {
      "id": "phone",
      "type": "phone",
      "label": "Patient's phone",
      "config": { "contact": "Harbor Dental", "subtitle": "Text message" }
    },
    {
      "id": "flow",
      "type": "workflow",
      "label": "What the system does",
      "config": {
        "nodes": [
          { "id": "text", "label": "New text message", "icon": "message" },
          { "id": "read", "label": "Reads what they need", "icon": "sparkle", "after": ["text"] },
          { "id": "slots", "label": "Finds open times", "app": "Calendar", "icon": "calendar", "after": ["read"] },
          { "id": "reply", "label": "Writes the reply", "icon": "message", "after": ["slots"] }
        ]
      }
    },
    {
      "id": "crm",
      "type": "crm",
      "label": "Your patient list",
      "config": {
        "columns": [
          { "id": "new", "title": "New" },
          { "id": "talking", "title": "In conversation" },
          { "id": "booked", "title": "Booked" }
        ],
        "cards": [
          { "id": "omar", "column": "talking", "title": "Omar Haddad", "subtitle": "Whitening quote", "value": "$340" },
          { "id": "marta", "column": "talking", "title": "Marta Kowalski", "subtitle": "Braces consult", "value": "$90" },
          { "id": "priya", "column": "booked", "title": "Priya Nair", "subtitle": "Check-up", "value": "$120", "tag": "Mon 9:30 AM", "tone": "good" },
          { "id": "joel", "column": "booked", "title": "Joel Okafor", "subtitle": "Filling", "value": "$210", "tag": "Tue 2 PM", "tone": "good" }
        ]
      }
    },
    {
      "id": "numbers",
      "type": "kpi",
      "label": "Your week",
      "config": {
        "tiles": [
          { "id": "reply", "label": "Time to first reply", "value": "14 h" },
          { "id": "closed", "label": "Booked while closed", "value": "$0" },
          { "id": "booked", "label": "New patients booked", "value": "2" }
        ]
      }
    }
  ],
  "beats": [
    {
      "say": "A $180 new patient sends this text. Your practice closed at six.",
      "clock": "9:14 PM",
      "do": [{ "on": "phone", "type": "send", "text": "Hi, Dana Whitfield here. I chipped a tooth. Can I come in this week?" }]
    },
    {
      "say": "Nobody is at the desk. The system reads it and checks your calendar.",
      "do": [
        { "on": "flow", "type": "run", "node": "text" },
        { "on": "flow", "type": "run", "node": "read", "note": "Chipped tooth, wants this week" },
        { "on": "flow", "type": "run", "node": "slots", "note": "Thu 10 AM and Fri 2:30 PM free" },
        { "on": "flow", "type": "run", "node": "reply", "note": "Offers both times" }
      ]
    },
    {
      "say": "It answers with real times, 38 seconds later. Nobody typed it.",
      "do": [
        { "on": "phone", "type": "typing" },
        { "on": "phone", "type": "receive", "text": "Sorry to hear that, Dana! We can see you Thursday at 10 AM or Friday at 2:30 PM. Which works best?", "after": 1100 }
      ]
    },
    {
      "say": "Dana is on your patient list before you have seen her text.",
      "do": [{ "on": "crm", "type": "add", "id": "dana", "to": "new", "title": "Dana Whitfield", "subtitle": "Chipped tooth", "tag": "Replied in 38 sec", "tone": "info" }]
    },
    {
      "say": "The patient picks a time. No phone tag tomorrow morning.",
      "clock": "9:16 PM",
      "do": [
        { "on": "phone", "type": "send", "text": "Thursday at 10 please" },
        { "on": "phone", "type": "receive", "text": "Done. You are booked for Thursday at 10 AM with Dr. Lin. See you then!", "after": 1100 },
        { "on": "crm", "type": "move", "card": "dana", "to": "booked" },
        { "on": "crm", "type": "set", "card": "dana", "value": "$180", "tag": "Thu 10 AM", "tone": "good", "after": 600 }
      ]
    },
    {
      "say": "You find out in the morning, with the chair already filled.",
      "clock": "7:30 AM",
      "do": [
        { "on": "numbers", "type": "set", "tile": "reply", "value": "38 sec", "delta": "was 14 h", "tone": "good" },
        { "on": "numbers", "type": "set", "tile": "closed", "value": "$180", "delta": "was $0", "tone": "good" },
        { "on": "numbers", "type": "set", "tile": "booked", "value": "3", "delta": "+1 overnight", "tone": "good" }
      ]
    }
  ],
  "outcome": [
    { "value": "38 sec", "label": "to first reply", "was": "14 h" },
    { "value": "$180", "label": "booked while you were closed", "was": "$0" },
    { "value": "+1", "label": "patient booked overnight" }
  ],
  "results": {
    "title": "What a missed evening text costs",
    "text": "We estimate 15 more of every 100 evening texts would book: 40 × 15% × $180 = $1,080 a month, $780 after the fee. Example fee: $300 a month, $1,500 once. Reply to my message and I'll set it up.",
    "roi": {
      "currency": "USD",
      "inputs": [
        { "id": "texts", "label": "After-hours texts a month", "ask": "How many texts come in after closing, in a month?", "value": 40 },
        {
          "id": "booked",
          "label": "Share of those that book a visit",
          "ask": "Of every 100 of those texts, how many book a visit today?",
          "note": "Our estimate adds 15 in 100: patients you lose today who would now book.",
          "value": 10,
          "kind": "percent"
        },
        {
          "id": "visit",
          "label": "Worth of a first visit",
          "ask": "What is a first visit worth to you?",
          "note": "$180 is the first visit only. What a patient spends later comes on top.",
          "value": 180,
          "kind": "money"
        }
      ],
      "lever": { "input": "booked", "add": 15 },
      "cost": { "monthly": 300, "once": 1500 }
    }
  }
}
